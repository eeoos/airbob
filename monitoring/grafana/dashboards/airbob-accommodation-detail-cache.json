          "editorMode": "code",
          "expr": "100 *\nsum(rate(accommodation_detail_cache_request_total{job=\"airbob\", application=\"airbob-api\", environment=~\"$environment\", instance=~\"$instance\", result=~\"hit|hit_after_wait|coalesced|negative_hit|negative_coalesced\"}[$__rate_interval]))\n/\nclamp_min(sum(rate(accommodation_detail_cache_request_total{job=\"airbob\", application=\"airbob-api\", environment=~\"$environment\", instance=~\"$instance\"}[$__rate_interval])), 0.000000001)",
          "instant": false,
