{
  "id": null,
  "uid": "airbob-cache-experiments",
  "title": "Airbob - Cache Experiments",
  "tags": [
    "airbob",
    "cache",
    "local-experiment"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "run_id",
        "label": "실행 ID",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(airbob_cache_experiment_phase, run_id)",
          "refId": "run"
        },
        "definition": "label_values(airbob_cache_experiment_phase, run_id)",
        "refresh": 2,
        "sort": 2,
        "multi": false,
        "includeAll": false,
        "current": {},
        "options": []
      },
      {
        "name": "variant",
        "label": "조건",
        "type": "custom",
        "query": "cache-off,cache-on,coalescing-off,coalescing-on",
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "options": []
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "이 대시보드 읽는 방법",
      "type": "text",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 4
      },
      "options": {
        "mode": "markdown",
        "content": "**실행 ID와 조건을 선택하세요.** 위쪽은 실시간 변화(예열 포함), 아래쪽은 완료된 측정 결과입니다. 종료 후에는 시간 범위를 실행 시각에 맞추세요."
      }
    },
    {
      "id": 2,
      "title": "현재 실행 단계",
      "type": "stat",
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 16,
        "h": 3
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": false
          },
          "noValue": "실험 대기 / 종료"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "airbob_cache_experiment_phase{run_id=~\"$run_id\"} or on() label_replace(label_replace(vector(1), \"phase\", \"실험 대기 또는 종료\", \"\", \"\"), \"stage\", \"실시간 수집 없음\", \"\", \"\")",
          "legendFormat": "{{phase}} / {{stage}}",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "interval": "1s",
          "range": false,
          "instant": true
        }
      ],
      "options": {
        "textMode": "name",
        "colorMode": "none",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 3,
      "title": "실험용 Redis 응답 상태",
      "type": "stat",
      "gridPos": {
        "x": 16,
        "y": 4,
        "w": 8,
        "h": 3
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "1=응답 가능, 0=응답 불능. 대상 자체가 없으면 실험 대기/종료.",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": false
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "-1": {
                  "text": "실험 대기 / 종료",
                  "color": "gray",
                  "index": 0
                },
                "0": {
                  "text": "응답 불능",
                  "color": "red",
                  "index": 1
                },
                "1": {
                  "text": "정상 응답",
                  "color": "green",
                  "index": 2
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "redis_up{namespace=\"cache-experiment\",run_id=~\"$run_id\"} or on() vector(-1)",
          "legendFormat": "{{instance}}",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "interval": "1s",
          "range": false,
          "instant": true
        }
      ],
      "options": {
        "textMode": "value",
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 4,
      "title": "요청 / 실제 DB 로딩 (최근 10초)",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 7,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "",
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(accommodation_detail_cache_request_total{job=\"airbob\",environment=\"cache-experiment\",run_id=~\"$run_id\",variant=~\"$variant\"}[10s]))",
