        "defaults": {
          "unit": "s",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95,sum by(le)(rate(http_server_requests_seconds_bucket{job=\"airbob\",environment=\"cache-experiment\",run_id=~\"$run_id\",variant=~\"$variant\",uri=\"/api/v1/accommodations/{accommodationId}\"}[10s])))",
          "legendFormat": "API (서버 히스토그램)",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "interval": "1s",
          "range": true,
          "instant": false
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95,sum by(le)(rate(accommodation_detail_cache_lock_wait_duration_seconds_bucket{job=\"airbob\",environment=\"cache-experiment\",run_id=~\"$run_id\",variant=~\"$variant\",result=\"acquired\"}[10s])))",
          "legendFormat": "락 대기",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "interval": "1s",
          "range": true,
