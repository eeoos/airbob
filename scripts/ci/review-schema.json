{
  "type": "object",
  "properties": {
    "overview": {
      "type": "string",
      "description": "리뷰한 변경과 결론을 한두 문장으로. 지적 건수는 쓰지 않는다."
    },
    "findings": {
      "type": "array",
      "description": "지적. 없으면 빈 배열.",
      "items": {
        "type": "object",
        "properties": {
          "location": {"type": "string", "description": "파일:줄. 여러 곳이면 쉼표로 나눈다."},
          "severity": {"type": "string", "enum": ["필수", "권장", "참고"]},
          "title": {"type": "string", "description": "한 줄 요약"},
          "problem": {"type": "string", "description": "무엇이 어떤 경우에 잘못되는지"},
          "evidence": {"type": "string", "description": "확인하거나 재현한 방법"},
          "suggestion": {"type": "string", "description": "고치는 방법"},
          "certain": {"type": "boolean", "description": "직접 확인했으면 true, 확인하지 못했으면 false"}
        },
        "required": ["location", "severity", "title", "problem", "evidence", "suggestion", "certain"],
        "additionalProperties": false
      }
    },
    "checked": {"type": "array", "items": {"type": "string"}, "description": "확인한 범위"},
    "unverified": {"type": "array", "items": {"type": "string"}, "description": "주어진 자료로 확인하지 못한 것"}
  },
  "required": ["overview", "findings", "checked", "unverified"],
  "additionalProperties": false
}
