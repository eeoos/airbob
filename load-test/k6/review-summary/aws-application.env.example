# 기존 Lab 앱 환경 파일에 병합할 값. 실제 비밀 값은 호스트 밖으로 내보내지 않는다.
# 준비 도구는 이 파일을 적용하거나 앱을 재시작하지 않는다.
SPRING_PROFILES_ACTIVE=aws,traffic-benchmark,read-model-benchmark
BENCHMARK_READ_MODEL_TOKEN=REPLACE_ON_HOST
AIRBOB_RUN_ID=REPLACE_WITH_EXISTING_LAB_RUN_ID
AIRBOB_RESOURCE_FENCING_TOKEN_SHA256=REPLACE_WITH_EXISTING_RESOURCE_FENCE_SHA256
AIRBOB_RUNTIME_REVISION=REPLACE_WITH_IMAGE_SHA256_WITHOUT_PREFIX
AIRBOB_APP_INSTANCE_ID=REPLACE_WITH_ACTUAL_APP_INSTANCE_ID
# 현재 코드에 맞게 이미 V28로 준비한 DB만 사용한다. 여기서 migration하지 않는다.
SPRING_FLYWAY_ENABLED=false
SPRING_FLYWAY_TARGET=28
SPRING_JPA_HIBERNATE_DDL_AUTO=none
SPRING_JPA_SHOW_SQL=false
SPRING_JPA_PROPERTIES_HIBERNATE_SHOW_SQL=false
SPRING_JPA_PROPERTIES_HIBERNATE_GENERATE_STATISTICS=false
SPRING_DATASOURCE_HIKARI_MAXIMUM_POOL_SIZE=10
# 로그인은 회원 행 잠금을 사용한다. 측정 API의 읽기 트랜잭션 설정은 코드에서 유지한다.
SPRING_DATASOURCE_HIKARI_READ_ONLY=false
ACCOMMODATION_DETAIL_CACHE_ENABLED=false
SPRING_KAFKA_LISTENER_AUTO_STARTUP=false
SPRING_KAFKA_ADMIN_AUTO_CREATE=false
OPERATOR_ALERT_KAFKA_AUTO_STARTUP=false
ACCOMMODATION_INDEXING_AUTO_STARTUP=false
ACCOMMODATION_INDEX_BOOTSTRAP_ENABLED=false
ACCOMMODATION_DETAIL_CACHE_INVALIDATION_AUTO_STARTUP=false
RESERVATION_INVENTORY_STARTUP_ENABLED=false
RESERVATION_INVENTORY_SEED_ENABLED=false
RESERVATION_INVENTORY_RETENTION_ENABLED=false
TOSS_PAYMENTS_ENABLED=false
GOOGLE_API_ENABLED=false
AWS_S3_WRITE_ENABLED=false
OPERATOR_ALERT_SLACK_ENABLED=false
LOGGING_LEVEL_ORG_HIBERNATE_SQL=OFF
LOGGING_LEVEL_ORG_HIBERNATE_ORM_JDBC_BIND=OFF
LOGGING_LEVEL_KR_KRO_AIRBOB_DOMAIN_AUTH=WARN
