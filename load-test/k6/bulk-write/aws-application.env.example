# Apply to one dedicated benchmark app. Preserve the original app configuration for restoration.
# Fill credentials on the host; do not include the resulting runtime file in any published bundle.
SPRING_PROFILES_ACTIVE=aws,bulk-delete-benchmark
BENCHMARK_BULK_WRITE_ENABLED=true
BENCHMARK_BULK_WRITE_ALLOWED_SCHEMA=airbob_bulk_write_benchmark
BENCHMARK_BULK_WRITE_TOKEN=REPLACE_ON_HOST_WITH_AT_LEAST_32_CHARACTERS
BENCHMARK_APP_COMMIT=REPLACE_WITH_FULL_DEPLOYED_COMMIT
BENCHMARK_IMAGE_DIGEST=sha256:REPLACE_WITH_DEPLOYED_IMAGE_DIGEST
# These must point at a separately migrated V28 disposable schema, never airbobdb or the shared B dataset.
SPRING_DATASOURCE_URL=jdbc:mysql://REPLACE_WITH_LAB_DB_HOST:3306/airbob_bulk_write_benchmark
SPRING_DATASOURCE_USERNAME=REPLACE_WITH_DISPOSABLE_SCHEMA_USER
SPRING_DATASOURCE_PASSWORD=REPLACE_ON_HOST
SPRING_DATASOURCE_HIKARI_MAXIMUM_POOL_SIZE=10
SPRING_DATASOURCE_HIKARI_READ_ONLY=false
JDBC_REWRITE_BATCHED_STATEMENTS=true
SPRING_FLYWAY_ENABLED=false
SPRING_JPA_HIBERNATE_DDL_AUTO=none
# Retain this lab's connection settings for session Redis, cache Redis, Kafka and Elasticsearch.
# The dedicated profile disables cache I/O, consumers, bootstrap, scheduling and external writes.
# Do not retain SPRING_PROFILES_INCLUDE, SPRING_CONFIG_* overrides or other experiment profiles.
